{
  "name": "github-actions-sample",
  "version": "1.0.0",
  "description": "Sample app for practicing GitHub Actions",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
